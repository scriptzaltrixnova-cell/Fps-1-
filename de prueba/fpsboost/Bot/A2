	local top = i
	while top.Parent and top.Parent ~= Workspace do top = top.Parent end
	if top.Parent ~= Workspace then return false end
	local p = Players:GetPlayerFromCharacter(top)
	return p ~= nil and p ~= LP
end

-- Overlays/fades de pantalla completa (Iris 4771x4771, flashes): se les quita la imagen (reversible)
XTRA.FADE = {Iris = true, RedOverlay = true, RedOverlay1 = true, RedOverlay2 = true,
	RainbowOverlay = true, WhiteFade = true, BlackFade = true}

-- Purga TOTAL de ReplicatedStorage.Assets (Animals + Fences + Eggs + resto = ~146k instancias)
function XTRA.purgeAll(on)
	if not on then return end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then notify(L("Purga total: no existe ReplicatedStorage.Assets", "Full purge: ReplicatedStorage.Assets does not exist")); return end
	local before = Stats:GetTotalMemoryUsageMb()
	local killed, k = 0, 0
	for _, d in ipairs(assets:GetDescendants()) do
		local c = d.ClassName
		if FXC[c] or LC[c] or c == "Texture" or c == "Decal" or c == "SurfaceAppearance" or c == "Highlight" then
			pcall(d.Destroy, d)
			killed += 1
		end
		k += 1
		if k % 1500 == 0 then task.wait() end
	end
	task.wait(2)
	notify(string.format(L("PURGA TOTAL: %d instancias borradas | MEM %.0f -> %.0f MB", "FULL PURGE: %d instances deleted | MEM %.0f -> %.0f MB"), killed, before, Stats:GetTotalMemoryUsageMb()))
end

-- Cerrar cuenta: cierra el cliente de Roblox (si el ejecutor no deja, la expulsa)
function XTRA.close()
	task.delay(0.5, function()
		pcall(function() game:Shutdown() end)
		task.delay(3, function() pcall(function() LP:Kick("FPS Boost: cuenta cerrada") end) end)
	end)
end

-- Rejoin: vuelve a entrar al MISMO servidor (si no puede, a uno nuevo a los 12s).
-- src = codigo que se re-ejecuta tras el salto (queue_on_teleport), para que el bot siga activo.
function XTRA.rejoin(src)
	local TS = game:GetService("TeleportService")
	local q = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
	if q and src then pcall(q, src) end
	task.wait(math.random() * 2) -- escalonado: evita que todos los bots salten en el mismo instante
	pcall(function() TS:TeleportToPlaceInstance(game.PlaceId, game.JobId, LP) end)
	task.delay(12, function() pcall(function() TS:Teleport(game.PlaceId, LP) end) end)
end

-- TIRABAT (solo bots): persigue a un jugador y le pega solo con el Bat.
--   .tirabat Nombre   |   .Bot1 tirabat Nombre (un solo bot)   |   .untirabat Nombre  (o .untirabat = detiene todo)
-- Sigue al objetivo por UserId: si se sale del servidor, ESPERA y continua cuando vuelva (hasta .untirabat).
-- Avisa SOLO por consola (F9) cuando cambia el estado: ON / no existe / esperando / sigo / sin Bat / OFF.
do
	local st = {uid = nil, name = "", conn = nil, last = 0, equipT = 0, stuckT = 0, state = "", lastErr = nil,
		mode = "direct", rayT = 0, pathUntil = 0, pathT = 0, wps = nil, wi = 2, computing = false, curb = false, los = false}
	local CFG = {STAND = 2.2, HIT = 3.2, TP_DIST = 70, RAY = 3.5} -- se queda casi pegado (2.2) / solo golpea a <= 3.2 studs / salto de recuperacion
	local ang = math.rad(LP.UserId % 360)
	local ring = Vector3.new(math.cos(ang), 0, math.sin(ang)) -- cada bot ataca desde un lado distinto (no se estorban)

	local function say(msg)
		notify(msg) -- solo consola (F9), nunca por chat
	end
	local function setState(s2, msg) -- avisa SOLO cuando cambia el estado (no satura el chat)
		if st.state == s2 then return end
		st.state = s2
		if msg then say(msg) end
	end
	local function isBat(t)
		if not t:IsA("Tool") then return false end
		return t:GetAttribute("Bat") ~= nil or string.find(string.lower(t.Name), "bat", 1, true) ~= nil
	end
	local function getBat(char)
		for _, t in ipairs(char:GetChildren()) do if isBat(t) then return t end end
		local bp = LP:FindFirstChildOfClass("Backpack")
		if bp then
			for _, t in ipairs(bp:GetChildren()) do if isBat(t) then return t end end
		end
		return nil
	end
	local function findTarget(q)
		q = string.lower(tostring(q or ""))
		if q == "" then return nil end
		local best
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP then
				local n, d = string.lower(p.Name), string.lower(p.DisplayName)
				if n == q or d == q or tostring(p.UserId) == q then return p end
				if not best and (string.sub(n, 1, #q) == q or string.sub(d, 1, #q) == q) then best = p end
			end
		end
		return best
	end
	local function stop(msg)
		if st.conn then st.conn:Disconnect(); st.conn = nil end
		st.uid = nil; st.state = ""; st.wps = nil; st.mode = "direct"; st.pathUntil = 0
		if msg then say(msg) end
	end

	-- deteccion de paredes: 3 rayos hacia delante (rodillas / pecho / cabeza) + linea de vision al objetivo
	local PFS = game:GetService("PathfindingService")
	local rayP = RaycastParams.new()
	rayP.FilterType = Enum.RaycastFilterType.Exclude
	local function scanAhead(root, dir, troot)
		local filt = {}
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl.Character then filt[#filt + 1] = pl.Character end -- los jugadores no cuentan como pared
		end
		rayP.FilterDescendantsInstances = filt
		local o, len = root.Position, CFG.RAY
		local low  = Workspace:Raycast(o + Vector3.new(0, -2, 0), dir * len, rayP)
		local mid  = Workspace:Raycast(o, dir * len, rayP)
		local high = Workspace:Raycast(o + Vector3.new(0, 2.5, 0), dir * len, rayP)
		local wall = (mid ~= nil and mid.Instance.CanCollide) or (high ~= nil and high.Instance.CanCollide)
		local curb = (low ~= nil and low.Instance.CanCollide) and not wall -- escalon bajo: se salta
		local los = Workspace:Raycast(o, troot.Position - o, rayP)
		local blocked = los ~= nil and los.Instance.CanCollide -- hay una pared entre el bot y el objetivo
		return wall, curb, blocked
	end
	local function requestPath(from, goal) -- no bloquea el Heartbeat
		if st.computing then return end
		st.computing = true
		task.spawn(function()
			local path = PFS:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, AgentCanClimb = false})
			local ok = pcall(function() path:ComputeAsync(from, goal) end)
			if ok and path.Status == Enum.PathStatus.Success then
				st.wps = path:GetWaypoints(); st.wi = 2
			else
				st.wps = nil
			end
			st.computing = false
		end)
	end

	local function inner(dt)
		if RUN and not RUN.alive then stop(); return end -- el script se volvio a ejecutar: esta copia vieja se apaga
		if not st.uid then return end
		local t = Players:GetPlayerByUserId(st.uid)
		if not t then
			setState("away", "tirabat: " .. st.name .. " no está en el servidor, espero")
			return
		end
		st.name = t.Name
		local char = LP.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local tch = t.Character
		local troot = tch and tch:FindFirstChild("HumanoidRootPart")
		local thum = tch and tch:FindFirstChildOfClass("Humanoid")
		if not (hum and root) or hum.Health <= 0 then return end -- yo reaparezco: espera
		if not (troot and thum) or thum.Health <= 0 then return end -- el objetivo reaparece: espera

		local now = os.clock()
		local bat = getBat(char)
		if not bat then setState("nobat", "tirabat: no tengo el Bat"); return end
		if bat.Parent ~= char then -- equipar el Bat
			if now - st.equipT > 0.5 then st.equipT = now; pcall(function() hum:EquipTool(bat) end) end
			return
		end
		if st.state ~= "on" then setState("on", "tirabat: sigo a " .. t.Name) end

		local tpos = troot.Position + troot.AssemblyLinearVelocity * 0.12 -- prediccion corta del movimiento
		local spot = tpos + ring * CFG.STAND
		local rp = root.Position
		local dist = Vector3.new(tpos.X - rp.X, 0, tpos.Z - rp.Z).Magnitude

		if dist > CFG.TP_DIST then -- muy lejos (el objetivo se teletransporto): recupera la posicion
			root.CFrame = CFrame.new(spot + Vector3.new(0, 2, 0)); return
		end

		-- 1) detectar pared / escalon / pared entre el bot y el objetivo (10 veces por segundo)
		if now - st.rayT > 0.1 then
			st.rayT = now
			local dv = Vector3.new(spot.X - rp.X, 0, spot.Z - rp.Z)
			local wall, curb, blocked = scanAhead(root, dv.Magnitude > 0.1 and dv.Unit or root.CFrame.LookVector, troot)
			st.curb, st.los = curb, blocked
			if wall or blocked then st.pathUntil = now + 2 end -- modo ruta mientras haya pared (+2s de margen)
		end
		local usePath = now < st.pathUntil
		if usePath ~= (st.mode == "path") then
			st.mode = usePath and "path" or "direct"
			if not usePath then st.wps = nil end
			notify(usePath and "tirabat: pared detectada, rodeando" or "tirabat: camino libre")
		end

		-- 2) moverse
		if dist > CFG.STAND + 0.4 or st.los then
			if usePath then
				if now - st.pathT > 0.8 then st.pathT = now; requestPath(rp, troot.Position) end
				local wp = st.wps and st.wps[st.wi]
				if wp then
					hum:MoveTo(wp.Position)
					if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
					if Vector3.new(wp.Position.X - rp.X, 0, wp.Position.Z - rp.Z).Magnitude < 3 then st.wi += 1 end
				else
					hum:MoveTo(spot) -- la ruta aun no esta lista: sigue intentando
				end
			elseif dist < 6 then
				hum:MoveTo(Vector3.new(tpos.X, rp.Y, tpos.Z)) -- ultimo tramo: pegarse al objetivo
			else
				hum:MoveTo(spot)
			end
			if st.curb then hum.Jump = true end -- escalon bajo
			if root.AssemblyLinearVelocity.Magnitude < 1.5 then -- chocando/atascado
				st.stuckT += dt
				if st.stuckT > 0.5 then hum.Jump = true end
				if st.stuckT > 1.2 then st.pathUntil = now + 3; st.stuckT = 0 end -- fuerza el modo ruta
			else
				st.stuckT = 0
			end
			if troot.Position.Y - rp.Y > 3.5 then hum.Jump = true end
		else
			hum:MoveTo(rp)
			st.stuckT = 0
		end

		if dist <= CFG.HIT and math.abs(troot.Position.Y - rp.Y) < 5 and not st.los then -- solo golpea muy cerca y sin paredes
			root.CFrame = CFrame.lookAt(rp, Vector3.new(tpos.X, rp.Y, tpos.Z)) -- mirar al objetivo
			local cam = Workspace.CurrentCamera
			if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, tpos + Vector3.new(0, 1.5, 0)) end -- apuntar la camara
			local cd = (tonumber(bat:GetAttribute("SwingCooldown")) or 1) + 0.04
			if bat.Enabled and now - st.last >= cd then
				st.last = now
				pcall(function() bat:Activate() end)
			end
		end
	end
	local function step(dt)
		local ok, err = pcall(inner, dt)
		if not ok and err ~= st.lastErr then st.lastErr = err; notify("Tirabat error: " .. tostring(err)) end
	end

	function XTRA.tira(q)
		q = tostring(q or "")
		if q == "" then say("tirabat: falta el nombre (.tirabat Nombre)"); return end
		local function arm(uid, name, inServer)
			if (MAIN.id ~= 0 and uid == MAIN.id) or (MAIN.name ~= "" and string.lower(name) == string.lower(MAIN.name)) then
				say("tirabat: no se puede atacar al Owner"); return
			end
			if uid == LP.UserId then return end
			st.uid, st.name = uid, name
			st.state = inServer and "on" or "away"; st.wps = nil; st.mode = "direct"; st.pathUntil = 0
			if not st.conn then st.conn = RunService.Heartbeat:Connect(step) end
			if inServer then say("tirabat ON -> " .. name) else say("tirabat: " .. name .. " no está en el servidor, espero") end
		end
		local p = findTarget(q)
		if p then arm(p.UserId, p.Name, true); return end
		task.spawn(function() -- no esta en el servidor: comprobar si el usuario existe (nombre completo)
			local ok, uid = pcall(function() return Players:GetUserIdFromNameAsync(q) end)
			if ok and uid then arm(uid, q, false) else say("tirabat: no encuentro a " .. q .. " (nombre completo si no está en el servidor)") end
		end)
	end
	function XTRA.untira(q, silent)
		if not st.uid then return end
		local ql = string.lower(tostring(q or ""))
		if ql ~= "" then
			local nm = string.lower(st.name)
			if not (ql == nm or ql == tostring(st.uid) or string.sub(nm, 1, #ql) == ql) then return end
		end
		stop(not silent and "tirabat OFF" or nil)
	end
end

-- EGGSCOME (solo bots): compra los huevos de ClientEggs (por rareza) y los lleva a la ZONA DE RECOLECCION (zona verde).
--   .eggsCome            -> todas las rarezas      .eggsCome rare epic   -> solo esas
--   .Bot1 eggsCome common                          .eggsCome off         -> detener
-- Rarezas: common uncommon rare epic legendary mythic secret exotic divine celestial (tambien en español).
-- Detecta la rareza leyendo los textos del cartel del huevo (ej. "Común"). Avisa solo por consola (F9).
do
	local st = {on = false, tok = 0, filter = nil, bought = 0, tried = setmetatable({}, {__mode = "k"})}
	local function norm(s)
		s = string.lower(tostring(s or ""))
		for a, b in pairs({["á"]="a", ["é"]="e", ["í"]="i", ["ó"]="o", ["ú"]="u", ["Á"]="a", ["É"]="e", ["Í"]="i", ["Ó"]="o", ["Ú"]="u"}) do
			s = string.gsub(s, a, b)
		end
		return s
	end
	-- orden importa: "poco comun" antes que "comun"
	local RAR = {
		{"uncommon", {"uncommon", "pococomun", "poco comun"}}, {"common", {"common", "comun"}},
		{"rare", {"rare", "raro"}}, {"epic", {"epic", "epico"}}, {"legendary", {"legendary", "legendario"}},
		{"mythic", {"mythic", "mitico"}}, {"secret", {"secret", "secreto"}}, {"exotic", {"exotic", "exotico"}},
		{"divine", {"divine", "divino"}}, {"celestial", {"celestial"}},
	}
	local function rarityIn(txt)
		txt = norm(txt)
		for _, r in ipairs(RAR) do
			for _, w in ipairs(r[2]) do
				if string.find(txt, w, 1, true) then return r[1] end
			end
		end
	end
	local function rarityOf(egg)
		local a = egg:GetAttribute("Rarity")
		local r = a and rarityIn(a)
		if r then return r end
		for _, d in ipairs(egg:GetDescendants()) do
			if d:IsA("TextLabel") and d.Text ~= "" and not string.find(d.Text, "^%$") then
				r = rarityIn(d.Text)
				if r then return r end
			end
		end
	end
	-- HUEVOS FALSOS: se saltean los que tengan alguna palabra "falsa" en nombre, atributos, tags o textos.
	local SKIP = {"fake", "falso", "falsa", "decoy", "trampa", "señuelo", "senuelo"}
	local function eggInfo(egg)
		local parts = {egg.Name}
		for k, v in pairs(egg:GetAttributes()) do parts[#parts + 1] = tostring(k) .. "=" .. tostring(v) end
		for _, tg in ipairs(CollectionService:GetTags(egg)) do parts[#parts + 1] = "tag:" .. tg end
		for _, d in ipairs(egg:GetDescendants()) do
			if d:IsA("TextLabel") and d.Text ~= "" then parts[#parts + 1] = "txt:" .. d.Text end
		end
		return table.concat(parts, " | ")
	end
	local function isFake(egg)
		-- [jugador disfrazado de huevo] el juego marca al jugador con el atributo Disguised=true.
		-- Es falso si el "huevo" es parte del personaje de otro jugador, o si un jugador disfrazado esta pegado a el.
		local ec = egg:FindFirstChild("EggCenter", true)
		local ep = (ec and ec:IsA("Attachment")) and ec.WorldPosition or (egg:IsA("BasePart") and egg.Position or egg:GetPivot().Position)
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl ~= LP then
				local ch = pl.Character
				if ch and (egg:IsDescendantOf(ch) or ch:IsDescendantOf(egg)) then return true, "personaje:" .. pl.Name end
				local dis = false
				for k, v in pairs(pl:GetAttributes()) do
					if string.find(norm(k), "disguis", 1, true) and v and v ~= "" then dis = true end
				end
				local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
				if dis and hrp and (hrp.Position - ep).Magnitude < 10 then return true, "disfrazado:" .. pl.Name end
			end
		end
		-- [anti-robo] solo huevos reales de la tienda: el prompt debe ser Buy/Comprar y el huevo no debe
		-- pertenecer a otro jugador (nombre o atributo = nombre/DisplayName/UserId de alguien del servidor)
		local bp = egg:FindFirstChild("BuyPrompt", true)
		if bp then
			local at = norm(bp.ActionText)
			if at ~= "buy" and at ~= "comprar" then return true, "prompt:" .. bp.ActionText end
		end
		local vals = {egg.Name}
		for _, v in pairs(egg:GetAttributes()) do vals[#vals + 1] = v end
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl ~= LP then
				for _, v in ipairs(vals) do
					local sv = norm(tostring(v))
					if sv == norm(pl.Name) or sv == norm(pl.DisplayName) or sv == tostring(pl.UserId) then return true, "jugador:" .. pl.Name end
				end
			end
		end
		local info = norm(eggInfo(egg))
		for _, w in ipairs(SKIP) do
			if string.find(info, norm(w), 1, true) then return true, w end
		end
		return false
	end
	local function cash()
		local ls = LP:FindFirstChild("leaderstats")
		local c = ls and ls:FindFirstChild("Cash")
		return c and tonumber(c.Value) or 0
	end
	local function eggPos(egg)
		local ec = egg:FindFirstChild("EggCenter", true)
		if ec and ec:IsA("Attachment") then return ec.WorldPosition end
		if egg:IsA("BasePart") then return egg.Position end
		return egg:GetPivot().Position
	end
	local function basePos()
		local b = Workspace:FindFirstChild("Bases")
		local m = b and b:FindFirstChild(tostring(LP:GetAttribute("Base") or ""))
		return m and m:GetPivot().Position
	end
	-- ZONA DE RECOLECCION: se busca el cartel "ZONA DE RECOLECCION" (SurfaceGui sobre una Part) y se elige la
	-- mas cercana a tu base. Se cachea; si no aparece, se usa el centro de la base como antes.
	local zones, zonesT = {}, 0
	local function isZoneText(t)
		t = norm(t)
		return string.find(t, "recolec", 1, true) or string.find(t, "collection", 1, true) or string.find(t, "collect zone", 1, true)
	end
	local function guiPart(gui)
		local a = gui.Adornee
		if a and a:IsA("BasePart") then return a end
		local par = gui.Parent
		if par and par:IsA("BasePart") then return par end
		return par and par:FindFirstAncestorWhichIsA("BasePart")
	end
	local function findZones()
		table.clear(zones)
		local seen, k = {}, 0
		local function add(part, why)
			if part and part:IsA("BasePart") and not seen[part] then
				seen[part] = true; zones[#zones + 1] = part
				notify("eggsCome: zona encontrada (" .. why .. "): " .. part:GetFullName())
			end
		end
		-- 1) textos "ZONA DE RECOLECCION" en el Workspace y tambien en PlayerGui (SurfaceGui con Adornee)
		for _, root in ipairs({Workspace, LP:FindFirstChild("PlayerGui")}) do
			if root then
				for _, d in ipairs(root:GetDescendants()) do
					if d:IsA("TextLabel") and isZoneText(d.Text) then
						local gui = d:FindFirstAncestorWhichIsA("SurfaceGui") or d:FindFirstAncestorWhichIsA("BillboardGui")
						if gui then add(guiPart(gui), "texto") else add(d:FindFirstAncestorWhichIsA("BasePart"), "texto") end
					elseif d:IsA("BasePart") and (isZoneText(d.Name) or isZoneText(d.Parent and d.Parent.Name or "")) and not d:IsDescendantOf(Workspace:FindFirstChild("ClientEggs") or LP) then
						add(d, "nombre")
					end
					k += 1
					if k % 2000 == 0 then task.wait() end
				end
			end
		end
		zonesT = os.clock()
		if #zones == 0 then notify("eggsCome: NO se encontro ninguna ZONA DE RECOLECCION") end
	end
	local function zonePart()
		if #zones == 0 and os.clock() - zonesT > 15 then findZones() end
		local ref = basePos() or (LP.Character and LP.Character:GetPivot().Position)
		-- prioridad: zonas que esten DENTRO de tu propia base; si no hay, la mas cercana a tu base
		local b = Workspace:FindFirstChild("Bases")
		local mine = b and b:FindFirstChild(tostring(LP:GetAttribute("Base") or ""))
		local best, bd
		for pass = 1, 2 do
			for _, z in ipairs(zones) do
				if z.Parent and ref and (pass == 2 or (mine and z:IsDescendantOf(mine))) then
					local d = (z.Position - ref).Magnitude
					if not bd or d < bd then best, bd = z, d end
				end
			end
			if best then break end
		end
		return best
	end
	local function buy(prompt)
		if fireproximityprompt then pcall(fireproximityprompt, prompt) return end
		pcall(function() prompt:InputHoldBegin(); task.wait(prompt.HoldDuration + 0.1); prompt:InputHoldEnd() end)
	end
	local function pick(root)
		local folder = Workspace:FindFirstChild("ClientEggs")
		if not folder then return end
		local best, bd
		for _, egg in ipairs(folder:GetChildren()) do
			local p = egg:FindFirstChild("BuyPrompt", true)
			local t = st.tried[egg]
			if p and p.Enabled and not (t and os.clock() - t < 10) and not isFake(egg) then
				local r = rarityOf(egg)
				if not st.filter or (r and st.filter[r]) then
					local d = (eggPos(egg) - root.Position).Magnitude
					if not bd or d < bd then best, bd = egg, d end
				end
			end
		end
		return best
	end
	local function loop(tok)
		while st.on and tok == st.tok and RUN.alive do
			local ok, err = pcall(function()
				local char = LP.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if not (hum and root) or hum.Health <= 0 then task.wait(1) return end
				local egg = pick(root)
				if not egg then task.wait(1) return end
				local p = egg:FindFirstChild("BuyPrompt", true)
				root.CFrame = CFrame.new(eggPos(egg) + Vector3.new(0, 3, 0)) -- a menos de 12 studs del prompt
				task.wait(0.15)
				if isFake(egg) then -- se disfrazo un jugador justo ahi: no comprar
					st.tried[egg] = os.clock(); notify("eggsCome: IGNORO " .. egg.Name .. " (jugador disfrazado)"); return
				end
				local c0 = cash()
				buy(p)
				task.wait(0.9)
				if cash() < c0 then
					st.bought += 1
					notify("eggsCome: comprado " .. egg.Name .. " (" .. tostring(rarityOf(egg) or "?") .. ") #" .. st.bought)
				else
					st.tried[egg] = os.clock() -- sin plata / otro lo compro: no insistir 10s
				end
				local z = zonePart() -- llevar el huevo a la ZONA DE RECOLECCION
				if z then
					root.CFrame = CFrame.new(z.Position + Vector3.new(0, z.Size.Y / 2 + 3, 0))
					task.wait(0.2)
					hum:MoveTo(z.Position)
					task.wait(1.5)
				else
					local bp = basePos()
					if bp then root.CFrame = CFrame.new(bp + Vector3.new(0, 5, 0)) end
					notify("eggsCome: no encontre la ZONA DE RECOLECCION, volvi a la base")
					task.wait(1.2)
				end
			end)
			if not ok then notify("eggsCome error: " .. tostring(err)); task.wait(2) end
		end
	end
	local ALIASES = {pococomun = "uncommon", comun = "common", raro = "rare", epico = "epic", legendario = "legendary",
		mitico = "mythic", secreto = "secret", exotico = "exotic", divino = "divine"}
	function XTRA.eggsCome(args)
		args = args or {}
		local a1 = args[1] and norm(args[1])
		if a1 == "off" or a1 == "stop" or a1 == "false" then
			if st.on then notify("eggsCome OFF (" .. st.bought .. " huevos)") end
			st.on = false; st.tok += 1; return
		end
		local f, any = {}, false
		for _, a in ipairs(args) do
			for part in string.gmatch(norm(a), "[^,]+") do
				local k = ALIASES[part] or part
				local valid = false
				for _, r in ipairs(RAR) do if r[1] == k then valid = true end end
				if valid then f[k] = true; any = true else notify("eggsCome: rareza desconocida '" .. part .. "'") end
			end
		end
		if #args > 0 and not any then return end
		st.filter = any and f or nil
		st.tok += 1; st.on = true; st.bought = 0; table.clear(st.tried)
		local names = {}
		for k in pairs(f) do names[#names + 1] = k end
		notify("eggsCome ON -> " .. (any and table.concat(names, ",") or "todas las rarezas"))
		task.spawn(loop, st.tok)
	end
end

