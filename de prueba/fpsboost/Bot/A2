-- Oculta (solo tu vista, reversible) carpetas/modelos del Workspace por nombre
local XTRA = {} -- helpers de las funciones nuevas (una sola local: el limite de Luau es 200)
function XTRA.hideNamed(names)
	local hidden, conns = {}, {}
	local function hideOne(d)
		if d:IsA("BasePart") then
			setProps(d, {LocalTransparencyModifier = 1}, true)
		elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") or FXC[d.ClassName] or LC[d.ClassName] then
			setProps(d, {Enabled = false}, true)
		else
			return
		end
		hidden[#hidden + 1] = d
	end
	return function(on)
		if on then
			local k = 0
			for _, n in ipairs(names) do
				local root = Workspace:FindFirstChild(n)
				if root then
					hideOne(root)
					for _, d in ipairs(root:GetDescendants()) do
						hideOne(d)
						k += 1
						if k % 1500 == 0 then task.wait() end
					end
					conns[#conns + 1] = root.DescendantAdded:Connect(function(d) task.defer(hideOne, d) end)
				end
			end
		else
			for _, c in ipairs(conns) do c:Disconnect() end
			table.clear(conns)
			for _, d in ipairs(hidden) do
				setProps(d, {LocalTransparencyModifier = 0}, false)
				setProps(d, {Enabled = false}, false)
			end
			table.clear(hidden)
		end
	end
end
