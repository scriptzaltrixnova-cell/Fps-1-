local function scan(f, on, ver)
	local n = 0
	for _, root in ipairs(f.roots and f.roots() or ROOTS) do
		for _, d in ipairs(root:GetDescendants()) do
			if f.ver ~= ver then return end -- se cambio el toggle, abortar
			if f.match(d) then
				if f.destroy then if on then pcall(d.Destroy, d) end else setProps(d, f.props, on) end
			end
			n += 1
			if n % 2000 == 0 then task.wait() end
		end
	end
end

