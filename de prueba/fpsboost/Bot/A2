local function saveCfg(silent)
	if not writefile then
		if not silent then notify(L("Este ejecutor no tiene writefile", "This executor has no writefile")) end
		return false
	end
	local feats = {}
	for _, f in ipairs(FEATURES) do
		if state[f.id] and f.id ~= "r3d" then feats[f.id] = true end -- r3d (pantalla negra) nunca se guarda
	end
	local okJ, json = pcall(function()
		return HttpService:JSONEncode({features = feats, cullR = CULL_R, fpsCap = curCap, alias = MYALIAS, saved = os.date("%Y-%m-%d %H:%M:%S")})
	end)
	if not okJ then return false end
	local okW = pcall(writefile, CFG_FILE, json)
	if not silent then notify(okW and (L("Guardado: workspace/", "Saved: workspace/") .. CFG_FILE) or L("No se pudo escribir el archivo", "Could not write the file")) end
	return okW
end

local function scheduleSave()
	if loading or saveQueued then return end
	saveQueued = true
	task.delay(0.6, function() saveQueued = false; saveCfg(true) end)
end

local function setFeature(f, on)
	if (state[f.id] or false) == on then return end -- ya esta asi: no duplicar bucles
	state[f.id] = on
	if f.custom then
		pcall(f.custom, on)
	else
		f.ver = (f.ver or 0) + 1
		local v = f.ver
		task.spawn(scan, f, on, v)
	end
	scheduleSave()
end

local function turbo(extreme)
	for _, f in ipairs(FEATURES) do
		if f.lvl == nil or (extreme and f.lvl == 1) then setFeature(f, true) end
	end
	if setfpscap then pcall(setfpscap, 9999) end
	curCap = 9999; scheduleSave()
end

-- Barra de progreso (una sola linea en consola al terminar)
local BAR_W = 20
local function progressBar(done, total)
	local pct = total > 0 and math.floor(done / total * 100 + 0.5) or 100
	local filled = math.floor(pct / 100 * BAR_W)
	return string.format("%d%% (%s%s)", pct, string.rep("=", filled), string.rep(" ", BAR_W - filled))
end

local function loadCfg(force)
	if not readfile then return end
	local okR, raw = pcall(readfile, CFG_FILE)
	if not okR or type(raw) ~= "string" or raw == "" then
		if force then notify(L("No hay configuracion guardada", "No saved configuration")) end
		return
	end
	local okD, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not okD or type(data) ~= "table" then notify(L("Configuracion corrupta", "Corrupted configuration")); return end
	if tonumber(data.cullR) then CULL_R = data.cullR end
	if tonumber(data.fpsCap) then curCap = data.fpsCap end
	if type(data.alias) == "string" then MYALIAS = data.alias end
	task.spawn(function()
		loading = true
		if not game:IsLoaded() then game.Loaded:Wait() end
		if not force then task.wait(6) end -- dejar que el juego termine de cargar antes de tocarlo
		if not RUN.alive then return end
		if curCap and setfpscap then pcall(setfpscap, curCap) end
		local todo = {}
		for _, f in ipairs(FEATURES) do
			if data.features and data.features[f.id] and not state[f.id] then todo[#todo + 1] = f end
		end
		for _, f in ipairs(todo) do
			if not RUN.alive then return end
			setFeature(f, true)
			task.wait(0.2)
		end
		if #todo > 0 then print("[FPSBoost] Loading config " .. progressBar(#todo, #todo)) end
		loading = false
		notify(L("Config aplicada: ", "Config applied: ") .. #todo .. L(" funciones", " features"))
	end)
end

