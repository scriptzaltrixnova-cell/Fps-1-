local orig = setmetatable({}, {__mode = "k"})

local function setProps(inst, props, on)
	local o = orig[inst]
	if on then
		if not o then o = {}; orig[inst] = o end
		for p, v in pairs(props) do
			if o[p] == nil then
				local ok, cur = pcall(function() return inst[p] end)
				if ok then o[p] = cur end
			end
			pcall(function() inst[p] = v end)
		end
	elseif o then
		for p in pairs(props) do
			if o[p] ~= nil then
				local saved = o[p]
				pcall(function() inst[p] = saved end)
				o[p] = nil
			end
		end
	end
end

