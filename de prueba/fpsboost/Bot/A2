-- Culling por distancia: oculta (solo en tu pantalla) parts lejos de la camara
local CULL_R = 300
local cullOn = false
local culled = setmetatable({}, {__mode = "k"})
local function cullFn(on)
	cullOn = on
	if not on then
		for p in pairs(culled) do pcall(function() p.LocalTransparencyModifier = 0 end) end
		table.clear(culled)
		return
	end
	task.spawn(function()
		local list, lastRefresh = {}, 0
		while cullOn do
			local now = os.clock()
			if now - lastRefresh > 8 then
				lastRefresh = now
				table.clear(list)
				local chars = {}
				for _, p in ipairs(Players:GetPlayers()) do
					if p.Character then chars[#chars + 1] = p.Character end
				end
				local k = 0
				for _, d in ipairs(Workspace:GetDescendants()) do
					if d:IsA("BasePart") and not d:IsA("Terrain") then
						local isChar = false
						for _, ch in ipairs(chars) do
							if d:IsDescendantOf(ch) then isChar = true break end
						end
						if not isChar then list[#list + 1] = d end
					end
					k += 1
					if k % 2000 == 0 then task.wait() end
				end
			end
			local cam = Workspace.CurrentCamera
			if cam then
				local pos = cam.CFrame.Position
				for i, p in ipairs(list) do
					pcall(function()
						local far = (p.Position - pos).Magnitude - p.Size.Magnitude / 2 > CULL_R
						if far then
							if not culled[p] then culled[p] = true; p.LocalTransparencyModifier = 1 end
						elseif culled[p] then
							culled[p] = nil; p.LocalTransparencyModifier = 0
						end
					end)
					if i % 1500 == 0 then task.wait() end
				end
			end
			task.wait(0.5)
		end
	end)
end

-- EggEvent con limite de frecuencia (token bucket): desactiva handlers del juego y los llama como maximo N veces/s
local THR_LIMIT = 20
local thrOrig, thrOwn = {}, nil
local function eggThrottleFn(on)
	local folder = ReplicatedStorage:FindFirstChild("EggRemotes")
	local ev = folder and folder:FindFirstChild("EggEvent")
	if not ev or not getconnections then notify(L("EggEvent o getconnections no disponible", "EggEvent or getconnections not available")); return end
	if on then
		for _, c in ipairs(getconnections(ev.OnClientEvent)) do
			table.insert(thrOrig, c)
			pcall(function() c:Disable() end)
		end
		local tokens, last = THR_LIMIT, os.clock()
		thrOwn = ev.OnClientEvent:Connect(function(...)
			local now = os.clock()
			tokens = math.min(THR_LIMIT, tokens + (now - last) * THR_LIMIT)
			last = now
			if tokens < 1 then return end
			tokens -= 1
			local args = table.pack(...)
			for _, c in ipairs(thrOrig) do
				pcall(function()
					if c.Fire then c:Fire(table.unpack(args, 1, args.n))
					elseif c.Function then c.Function(table.unpack(args, 1, args.n)) end
				end)
			end
		end)
		notify(L("EggEvent limitado a ", "EggEvent limited to ") .. THR_LIMIT .. "/s (" .. #thrOrig .. " handlers)")
	else
		if thrOwn then thrOwn:Disconnect(); thrOwn = nil end
		for _, c in ipairs(thrOrig) do pcall(function() c:Enable() end) end
		table.clear(thrOrig)
	end
end

