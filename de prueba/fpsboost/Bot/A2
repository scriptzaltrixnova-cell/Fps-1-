local notify = function(t) print("[FPSBoost] " .. t) end

local function bench()
	notify(L("Midiendo 3s...", "Measuring 3s..."))
	local dts = {}
	local c = RunService.Heartbeat:Connect(function(dt) dts[#dts + 1] = dt end)
	task.wait(3)
	c:Disconnect()
	table.sort(dts)
	local n, sum = #dts, 0
	for _, d in ipairs(dts) do sum += d end
	local worst = math.max(1, math.floor(n * 0.01))
	local ws = 0
	for i = n - worst + 1, n do ws += dts[i] end
	local msg = string.format(L("BENCH  prom %.0f | min %.0f | 1%% low %.0f FPS", "BENCH  avg %.0f | min %.0f | 1%% low %.0f FPS"), n / sum, 1 / dts[n], worst / ws)
	notify(msg)
	return msg
end

-- Purga de plantillas pesadas en ReplicatedStorage.Assets (Animals/Fences = ~113k de 142k instancias)
local function purgeFn(on)
	if not on then return end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then notify(L("Purga: no existe ReplicatedStorage.Assets", "Purge: ReplicatedStorage.Assets does not exist")); return end
	local before = Stats:GetTotalMemoryUsageMb()
	local killed, k = 0, 0
	for _, name in ipairs({"Animals", "Fences"}) do
		local folder = assets:FindFirstChild(name)
		if folder then
			for _, d in ipairs(folder:GetDescendants()) do
				local c = d.ClassName
				if FXC[c] or LC[c] or c == "Texture" or c == "Decal" or c == "SurfaceAppearance" then
					pcall(d.Destroy, d)
					killed += 1
				end
				k += 1
				if k % 1500 == 0 then task.wait() end
			end
		end
	end
	task.wait(2)
	notify(string.format(L("PURGA: %d instancias borradas | MEM %.0f -> %.0f MB", "PURGE: %d instances deleted | MEM %.0f -> %.0f MB"), killed, before, Stats:GetTotalMemoryUsageMb()))
end

