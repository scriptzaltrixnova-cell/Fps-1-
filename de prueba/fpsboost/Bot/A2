-- [v3] Desmonta (Parent=nil, solo en tu cliente) las bases ajenas: Workspace.Bases = ~11k instancias
-- (animales con huesos/VFXShell). Reversible: al apagar vuelven a su sitio. Si el juego lee esas bases
-- puede dar errores en consola; en ese caso usa "Ocultar bases ajenas" en su lugar.
XTRA.detached = {}
function XTRA.detachBases(on)
	local bases = Workspace:FindFirstChild("Bases")
	if on then
		if not bases then notify(L("No existe Workspace.Bases", "Workspace.Bases does not exist")); return end
		local mine = tostring(LP:GetAttribute("Base") or "")
		if mine == "" or not bases:FindFirstChild(mine) then
			notify(L("No pude identificar tu base (atributo Base). Cancelado.", "Could not identify your base (Base attribute). Cancelled."))
			return
		end
		local n = 0
		for _, b in ipairs(bases:GetChildren()) do
			if b.Name ~= mine then
				XTRA.detached[#XTRA.detached + 1] = {b, bases}
				pcall(function() b.Parent = nil end)
				n += 1
			end
		end
		notify(L("Bases desmontadas: ", "Bases detached: ") .. n .. " (" .. L("tu base: ", "your base: ") .. mine .. ")")
	else
		for _, e in ipairs(XTRA.detached) do
			if e[2].Parent then pcall(function() e[1].Parent = e[2] end) end
		end
		table.clear(XTRA.detached)
	end
end

