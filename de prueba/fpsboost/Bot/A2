-- Modo AFK: tras N segundos sin input apaga el render 3D y baja a 10 FPS; cualquier input lo revierte
local AFK_SECS = 60
local afkOn, afkActive, lastInput, afkTok = false, false, os.clock(), 0
local afkConns = {}
local function afkWake()
	lastInput = os.clock()
	if afkActive then
		afkActive = false
		pcall(function() RunService:Set3dRenderingEnabled(true) end)
		if setfpscap then pcall(setfpscap, curCap or 9999) end
	end
end
local function afkFn(on)
	afkOn = on
	afkTok += 1
	local tok = afkTok
	for _, c in ipairs(afkConns) do c:Disconnect() end
	table.clear(afkConns)
	if not on then afkWake(); return end
	lastInput = os.clock()
	afkConns[1] = UIS.InputBegan:Connect(afkWake)
	afkConns[2] = UIS.InputChanged:Connect(afkWake)
	task.spawn(function()
		while afkOn and tok == afkTok do
			if not afkActive and os.clock() - lastInput > AFK_SECS then
				afkActive = true
				pcall(function() RunService:Set3dRenderingEnabled(false) end)
				if setfpscap then pcall(setfpscap, 10) end
				notify(L("Modo AFK activo: mueve el mouse o toca una tecla para volver", "AFK mode active: move the mouse or press a key to return"))
			end
			task.wait(2)
		end
	end)
end

