-- Oculta (solo en tu pantalla) las bases de otros jugadores: Workspace.Bases (~2200 instancias)
local baseHidden, baseConn = {}, nil
local function hideBaseInst(d)
	if d:IsA("BasePart") then
		setProps(d, {LocalTransparencyModifier = 1}, true)
	elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") or FXC[d.ClassName] or LC[d.ClassName] then
		setProps(d, {Enabled = false}, true)
	else
		return
	end
	baseHidden[#baseHidden + 1] = d
end
local function basesFn(on)
	local bases = Workspace:FindFirstChild("Bases")
	if not bases then notify(L("No existe Workspace.Bases", "Workspace.Bases does not exist")); return end
	if on then
		local mine = tostring(LP:GetAttribute("Base") or "")
		if mine == "" or not bases:FindFirstChild(mine) then
			notify(L("No pude identificar tu base (atributo Base). Cancelado.", "Could not identify your base (Base attribute). Cancelled."))
			return
		end
		local k = 0
		for _, b in ipairs(bases:GetChildren()) do
			if b.Name ~= mine then
				for _, d in ipairs(b:GetDescendants()) do
					hideBaseInst(d)
					k += 1
					if k % 1500 == 0 then task.wait() end
				end
			end
		end
		baseConn = bases.DescendantAdded:Connect(function(d)
			local top = d
			while top.Parent and top.Parent ~= bases do top = top.Parent end
			if top.Name ~= mine then task.defer(hideBaseInst, d) end
		end)
		notify(L("Bases ajenas ocultas (tu base: ", "Other bases hidden (your base: ") .. mine .. "), " .. #baseHidden .. L(" instancias", " instances"))
	else
		if baseConn then baseConn:Disconnect(); baseConn = nil end
		for _, d in ipairs(baseHidden) do
			setProps(d, {LocalTransparencyModifier = 0}, false)
			setProps(d, {Enabled = false}, false)
		end
		table.clear(baseHidden)
	end
end

