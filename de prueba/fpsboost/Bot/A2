-- atajos: nombres cortos para los comandos mas usados
local ALIAS = {t="turbo", x="extreme", r="restore", reset="restore", normal="restore", fps="cap", s="status", h="help", ayuda="help", comandos="help",
	cerrar="close", cerrartodos="closeall", reconectar="rejoin", reconectartodos="rejoinall", rj="rejoin", rjall="rejoinall"}

local function runCommand(cmd, args)
	cmd = string.lower(cmd or ""); cmd = ALIAS[cmd] or cmd; args = args or {}
	local a1 = args[1] and string.lower(args[1]) or nil
	if cmd == "turbo" then turbo(false)
	elseif cmd == "extreme" or cmd == "extremo" then turbo(true)
	elseif cmd == "restore" or cmd == "restaurar" then restoreAll()
	elseif cmd == "cap" then
		local n = (a1 == "max") and 9999 or tonumber(a1)
		if not n or n < 1 then return false, "usage: .cap <number|max>" end
		if setfpscap then pcall(setfpscap, n) end
		curCap = n; refreshCap(); scheduleSave()
	elseif cmd == "on" or cmd == "off" or cmd == "toggle" then
		if #args == 0 then return false, "usage: ." .. cmd .. " <id> [id...]" end
		local bad = {}
		for _, id in ipairs(args) do
			local f = FBYID[string.lower(id)]
			if f then
				if cmd == "toggle" then setFeature(f, not state[f.id]) else setFeature(f, cmd == "on") end
			else
				bad[#bad + 1] = id
			end
		end
		if #bad > 0 then return false, "unknown id: " .. table.concat(bad, ",") end
	elseif cmd == "afk" then setFeature(FBYID.afk, a1 ~= "off")
	elseif cmd == "cull" then
		if a1 == "off" then
			setFeature(FBYID.cull, false)
		else
			local r = tonumber(a1)
			if not r or r < 1 then return false, "usage: .cull <radius|off>" end
			CULL_R = r; refreshRad(); setFeature(FBYID.cull, true); scheduleSave()
		end
	elseif cmd == "status" then reply(statusText())
	elseif cmd == "bench" then task.spawn(function() local m = bench(); if m then reply(m) end end)
	elseif cmd == "gc" then task.spawn(function() local m = gcFn(); if m then reply(m) end end)
	elseif cmd == "save" then saveCfg(false)
	elseif cmd == "load" then loadCfg(true)
	elseif cmd == "help" then reply(HELP)
	elseif cmd == "alias" then -- ".Bot1 alias ana" -> luego ".ana turbo" (".Bot1 alias off" lo quita)
		local v = string.gsub(a1 or "", "[^%w_]", "")
		if v == "off" then v = "" end
		MYALIAS = string.sub(v, 1, 16); scheduleSave()
	elseif cmd == "tirabat" then if ROLE == "bot" then XTRA.tira(args[1]) end
	elseif cmd == "untirabat" then if ROLE == "bot" then XTRA.untira(args[1]) end
	elseif cmd == "eggscome" then if ROLE == "bot" then XTRA.eggsCome(args) end
	elseif cmd == "close" then XTRA.close()
	elseif cmd == "rejoin" then task.spawn(XTRA.rejoin, requeueSrc())
	elseif cmd == "closeall" then if ROLE == "bot" then XTRA.close() end
	elseif cmd == "rejoinall" then if ROLE == "bot" then task.spawn(XTRA.rejoin, requeueSrc()) end
	elseif FBYID[cmd] then -- comando directo por id: ".fx" activa, ".fx off" apaga
		setFeature(FBYID[cmd], a1 ~= "off")
	else return false, "unknown command: " .. cmd end
	return true
end

-- ---------- escucha de comandos por chat (prefijo ".") ----------
-- ".turbo" = todas las cuentas | ".MiBot1 turbo" / ".1234567890 cap 60" = solo esa cuenta
-- ".bot1,bot2 turbo" = varias cuentas | ".* turbo" = todas
local CMDS = {turbo=1, extreme=1, extremo=1, restore=1, restaurar=1, cap=1, on=1, off=1, toggle=1, afk=1,
	cull=1, status=1, bench=1, gc=1, save=1, load=1, help=1, close=1, rejoin=1, closeall=1, rejoinall=1, alias=1, tirabat=1, untirabat=1, eggscome=1}

local function targetMatches(t)
	t = string.lower(t or "")
	if t == "all" or t == "*" or t == "todos" then return true end
	local name, disp = string.lower(LP.Name), string.lower(LP.DisplayName)
	for part in string.gmatch(t, "[^,]+") do
		if part == name or part == disp or tonumber(part) == LP.UserId or (MYALIAS ~= "" and part == MYALIAS) then return true end
		-- basta con las primeras letras (minimo 3): ".bot turbo" -> Bot1, Bot2...
		if #part >= 3 and (string.sub(name, 1, #part) == part or string.sub(disp, 1, #part) == part
			or (MYALIAS ~= "" and string.sub(MYALIAS, 1, #part) == part)) then return true end
	end
	return false
end

local function parseCommand(msg)
	if type(msg) ~= "string" or string.sub(msg, 1, #CMD_PREFIX) ~= CMD_PREFIX then return end
	local w = {}
	for _, x in ipairs(string.split(string.sub(msg, #CMD_PREFIX + 1), " ")) do
		if x ~= "" then w[#w + 1] = x end
	end
	if #w == 0 then return end
	local function canon(x) x = string.lower(x); return ALIAS[x] or x end
	local function isCmd(x) x = canon(x); return CMDS[x] or FBYID[x] end
	if isCmd(w[1]) then
		local c = canon(w[1])
		if c == "close" or c == "rejoin" then return end -- sin nombre no hace nada: usa .Bot1 close o .closeall
		return "all", c, {table.unpack(w, 2)}
	end
	-- solo un numero = limite de FPS (".60", ".144"); los UserId (largos) no se confunden
	local n = tonumber(w[1])
	if #w == 1 and n and n >= 10 and n <= 9999 then return "all", "cap", {w[1]} end
	if #w == 1 and string.lower(w[1]) == "max" then return "all", "cap", {"max"} end
	if w[2] then
		local c, t = canon(w[2]), string.lower(w[1])
		if (c == "close" or c == "rejoin") and (t == "all" or t == "*" or t == "todos") then c = c .. "all" end
		return w[1], c, {table.unpack(w, 3)}
	end
end

local function onChatCommand(msg, who)
	if RUN and not RUN.alive then return end
	if msg == lastCmd and os.clock() - lastCmdT < 1 then return end -- evita doble disparo (Chatted + TextChat)
	local target, cmd, args = parseCommand(msg)
	if not cmd then return end
	lastCmd, lastCmdT = msg, os.clock()
	if not targetMatches(target) then return end
	local okc, res, err = pcall(runCommand, cmd, args)
	if okc and res then
		notify(L("Comando de ", "Command from ") .. who .. ": " .. msg)
	else
		notify(L("Comando invalido de ", "Invalid command from ") .. who .. ": " .. msg .. " (" .. tostring(okc and err or res) .. ")")
	end
end

-- el bot escucha SOLO el chat de la cuenta Owner
if ROLE == "bot" then
	local function hookOwner(p)
		if isOwner(p) then p.Chatted:Connect(function(m) onChatCommand(m, p.Name) end) end
	end
	for _, p in ipairs(Players:GetPlayers()) do hookOwner(p) end
	Players.PlayerAdded:Connect(hookOwner)
	pcall(function()
		TextChatService.MessageReceived:Connect(function(m)
			local src = m.TextSource
			local pl = src and Players:GetPlayerByUserId(src.UserId)
			if pl and isOwner(pl) then onChatCommand(m.Text, pl.Name) end
		end)
	end)
end

